# AWS Configuration
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS EMF Configuration (for python services)
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

# AWS Bedrock Configuration
AWS_BEARER_TOKEN_BEDROCK=

CLAUDE_HAIKU_MODEL_CONFIG="{model_id},{inference_profile},{guardrail_id}:{guardrail_version}"
CLAUDE_SONNET_MODEL_CONFIG="{model_id},{inference_profile},{guardrail_id}:{guardrail_version}"

# ai-uc-content-swarm-runtime configuration
CONTEXT_BUCKET=ai-uc-content-swarm-context

RUNTIME_URL=http://ai-uc-content-swarm-runtime:8085

# Shared configuration
CDP_UPLOADER_BASE_URL=http://host.docker.internal:7337
UPLOADER_URL=http://localhost:7337

SWARM_INVOKE_QUEUE_URL=http://sqs.eu-west-2.127.0.0.1:4566/000000000000/ai_content_swarm_invoke
